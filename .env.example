# --- GoHighLevel ---------------------------------------------------------------
# Paste the Inbound Webhook URL from your GHL workflow trigger here.
# In GHL: Automations → Workflows → New → Trigger: "Inbound Webhook" → copy URL.
# See CONNECT_GHL.md for the full step-by-step.
#
# If unset, the form will accept submissions and log them to the console but
# will NOT forward to GHL. (Useful for local dev without touching production.)
GHL_INBOUND_WEBHOOK_URL=

# --- Google Ads conversion tracking --------------------------------------------
# The Google Ads tag (AW-11038716571) is hard-coded in index.html. These two
# vars are the per-conversion-action LABELS. Get them from Google Ads after
# creating each conversion action (Tools → Conversions → the action → "Use
# Google tag" → the send_to value looks like AW-11038716571/AbC-D_xyz123;
# the part AFTER the slash is the label). Leave blank until then — the
# tracking helper safely no-ops when a label is missing.
VITE_GADS_LEAD_LABEL=
VITE_GADS_PHONE_LABEL=
